# Public site origin used for canonical URLs, sitemap, OpenGraph, and JSON-LD.
# Falls back to http://localhost:3000 when unset. Must include scheme, no trailing slash.
NEXT_PUBLIC_APP_URL=

# NextAuth session signing and encryption secret. Generate with:
# openssl rand -base64 32
NEXTAUTH_SECRET=

# GitHub service credential for all Articles, glossary, and site-repository
# access. Use a classic PAT with public_repo scope when glossary PRs are enabled.
GITHUB_TOKEN=
GITHUB_ARTICLES_REPO_OWNER=techmc-wiki
GITHUB_ARTICLES_REPO_NAME=Articles

# Public Vercel Blob store for temporary large article uploads (>=4.5MB)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_HOSTNAME=

# Separate PRIVATE Vercel Blob store for drafts, draft images, and profile overrides.
# Do not reuse the public upload store token.
DRAFT_BLOB_READ_WRITE_TOKEN=

# GitHub OAuth app credentials for sign-in (ownership uses GitHub numeric IDs).
GITHUB_ID=
GITHUB_SECRET=

# Set to 0 to use real GitHub sign-in locally instead of the debug fixture.
GTMC_DEV_FIXTURE_AUTH=

# Glossary submodule integration
# Upstream target repo:
GITHUB_GLOSSARY_REPO_OWNER=TechMC-Glossary
GITHUB_GLOSSARY_REPO_NAME=TechMC-Glossary
# Our fork repo (where branches and commits are pushed before opening PR):
GITHUB_GLOSSARY_FORK_REPO_OWNER=techmc-wiki

# PDF workflow / download storage. R2 credentials are used by local CI tooling;
# NEXT_PUBLIC_PDF_BASE_URL is the public R2 (r2.dev or custom-domain) base URL
# configured in Vercel for the site download page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_PDF_BASE_URL=
