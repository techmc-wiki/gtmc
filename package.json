{
  "name": "gtmc-workspace",
  "version": "2.10.1",
  "private": true,
  "description": "GTMC monorepo root. The Next.js site lives in apps/web; the Typst book PDF pipeline lives in tools/pdf.",
  "repository": {
    "type": "git",
    "url": "https://github.com/techmc-wiki/gtmc.git"
  },
  "scripts": {
    "analyze": "pnpm --filter @gtmc/web run analyze",
    "articles:init": "git submodule update --init --recursive content/articles",
    "articles:status": "git submodule status content/articles",
    "articles:update": "git submodule update --remote content/articles",
    "build:content": "pnpm --filter @gtmc/web run build:content",
    "build:next": "pnpm --filter @gtmc/web run build:next",
    "build:pdf": "pnpm --filter @gtmc/web run build:pdf",
    "build:vercel": "pnpm --filter @gtmc/web run build:vercel",
    "build": "pnpm --filter @gtmc/web run build",
    "bump": "vpx scripts/bump.ts",
    "check": "vp check && pnpm typecheck",
    "dev": "pnpm --filter @gtmc/web run dev",
    "doctor": "pnpm --filter @gtmc/web run doctor",
    "fmt:fix": "vp fmt --write",
    "fmt": "vp fmt --check",
    "generate:aliases": "pnpm --filter @gtmc/web run generate:aliases",
    "generate:content": "pnpm --filter @gtmc/web run generate:content",
    "generate:contributors": "pnpm --filter @gtmc/web run generate:contributors",
    "generate:glossary": "pnpm --filter @gtmc/web run generate:glossary",
    "generate:manifest": "pnpm --filter @gtmc/web run generate:manifest",
    "glossary:init": "git submodule update --init --recursive content/glossary",
    "glossary:status": "git submodule status content/glossary",
    "glossary:update": "git submodule update --remote content/glossary",
    "lint:fix": "vp lint --fix",
    "lint": "vp lint",
    "test": "pnpm --filter @gtmc/web run test",
    "typecheck": "pnpm --filter @gtmc/ssg run typecheck && pnpm --filter @gtmc/web run typecheck",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
